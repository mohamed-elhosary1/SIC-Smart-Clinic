{
  "version": 2,
  "name": "sic-clinic",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/staff",
      "dest": "/staff.html"
    },
    {
      "src": "/doctor",
      "dest": "/doctor.html"
    },
    {
      "src": "/patient",
      "dest": "/patient.html"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}