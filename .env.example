# Smart Clinic - Cloud Synchronization & Recovery Configuration
# Rename this file to .env to enable production cloud persistence.

# Global switch (true / false)
CLOUD_SYNC_ENABLED=true

# Option 1: Vercel KV / Upstash Redis (Recommended for Vercel / Serverless)
# KV_REST_API_URL=https://your-upstash-redis-url.upstash.io
# KV_REST_API_TOKEN=your_upstash_bearer_token

# Option 2: JSONBin.io (Zero-setup free JSON storage)
# JSONBIN_BIN_ID=your_bin_id
# JSONBIN_API_KEY=your_jsonbin_secret_key

# Option 3: Custom REST API Endpoint (POST / GET webhook)
# CLOUD_SYNC_URL=https://api.yourclinic.com/v1/sync
# CLOUD_SYNC_TOKEN=bearer_secret_token
